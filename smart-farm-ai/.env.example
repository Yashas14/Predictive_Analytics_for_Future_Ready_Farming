# Environment Configuration for AgriSense AI
# Copy this file to .env and adjust values as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Model Configuration
MODEL_PATH=models/v1/model.pkl
MODEL_VERSION=1.0.0
RANDOM_STATE=42

# Database
DATABASE_URL=sqlite:///./predictions.db

# Frontend
BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data
DATA_DIR=data
