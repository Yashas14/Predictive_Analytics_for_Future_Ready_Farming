# AgriSense AI - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Model files (large)
models/v1/model.pkl
*.pkl
!models/v1/.gitkeep

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# Data (keep .gitkeep only)
data/*.csv
data/uploads/
!data/.gitkeep

# Docker
.docker/

# Coverage
.coverage
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Environment
.env
